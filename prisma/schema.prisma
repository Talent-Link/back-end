generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  RH
  CANDIDATO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  photoUrl  String?
  userType  UserType
  createdAt DateTime @default(now())

  // relação inversa para Form
  forms Form[] @relation("UserForms")
}

model Form {
  id          String  @id @default(cuid())
  title       String
  description String?
  questions   Json
  recruiterId String

  // relação para User, referenciando recruiterId
  recruiter User @relation("UserForms", fields: [recruiterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
