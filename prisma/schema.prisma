generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  RH
  CANDIDATO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  photoUrl  String?
  userType  UserType
  createdAt DateTime @default(now())

  // Relação inversa para Form (RH cria formulários)
  forms Form[] @relation("UserForms")

  // Relação inversa para Response (Candidato responde formulários)
  responses Response[]

  // Relação inversa para Feedbacks
  feeedbacks Feedback[]

  // Relação inversa para Company (RH gerencia uma empresa)
  company Company?
}

model Company {
  id          String         @id @default(cuid())
  name        String
  description String?
  address     String
  recruiterId String         @unique
  recruiter   User           @relation(fields: [recruiterId], references: [id])
  createdAt   DateTime       @default(now())

  // Relação para oportunidades criadas pela empresa
  opportunities Opportunity[]
}

model Form {
  id          String   @id @default(cuid())
  title       String
  description String?
  questions   Json
  recruiterId String

  // Relação para User, referenciando recruiterId
  recruiter User @relation("UserForms", fields: [recruiterId], references: [id])


  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relação inversa para Opportunity (Oportunidades que utilizam este formulário)
  opportunities Opportunity[]
}

model Response {
  id            String       @id @default(cuid())
  candidateId   String
  opportunityId String
  answers       Json
  createdAt     DateTime     @default(now())

  candidate     User         @relation(fields: [candidateId], references: [id])
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
}

model Feedback {
  id          String   @id @default(cuid())
  candidate   User     @relation(fields: [candidateId], references: [id])
  candidateId String
  subject     String
  message     String
  createdAt   DateTime @default(now())
}

model Opportunity {
  id          String   @id @default(cuid())
  title       String
  description String
  location    String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  formId      String?
  form        Form?    @relation(fields: [formId], references: [id])
  createdAt   DateTime @default(now())

  // Relação inversa para Response (Respostas associadas à oportunidade)
  responses   Response[]
}