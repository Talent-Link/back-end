generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String?
  photoUrl               String?
  userType               UserType
  createdAt              DateTime            @default(now())
  password               String?
  emailConfirmationToken String?
  isEmailConfirmed       Boolean             @default(false)
  company                Company?
  favoritedByRecruiters  FavoriteCandidate[] @relation("CandidateFavorites")
  favoriteCandidates     FavoriteCandidate[] @relation("RecruiterFavorites")
  forms                  Form[]              @relation("UserForms")
  notifications          Notification[]
  responses              Response[]
}

model FavoriteCandidate {
  id          String   @id @default(cuid())
  candidateId String
  recruiterId String
  createdAt   DateTime @default(now())
  candidate   User     @relation("CandidateFavorites", fields: [candidateId], references: [id])
  recruiter   User     @relation("RecruiterFavorites", fields: [recruiterId], references: [id])

  @@unique([candidateId, recruiterId])
}

model Company {
  id            String        @id @default(cuid())
  name          String
  description   String?
  address       String
  recruiterId   String        @unique
  createdAt     DateTime      @default(now())
  recruiter     User          @relation(fields: [recruiterId], references: [id])
  opportunities Opportunity[]
}

model Form {
  id            String        @id @default(cuid())
  title         String
  description   String?
  questions     Json
  recruiterId   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
  recruiter     User          @relation("UserForms", fields: [recruiterId], references: [id])
  opportunities Opportunity[]
}

model Response {
  id            String         @id @default(cuid())
  candidateId   String
  answers       Json
  createdAt     DateTime       @default(now())
  opportunityId String
  notifications Notification[]
  candidate     User           @relation(fields: [candidateId], references: [id])
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id])

  @@unique([candidateId, opportunityId], map: "unique_candidate_opportunity")
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  score      Int?
  status     String?
  responseId String?
  response   Response?        @relation(fields: [responseId], references: [id])
  user       User             @relation(fields: [userId], references: [id])
}

model Opportunity {
  id           String     @id @default(cuid())
  title        String
  description  String
  location     String
  companyId    String
  createdAt    DateTime   @default(now())
  formId       String?
  requirements String?
  benefits     String?
  isActive     Boolean    @default(true)
  company      Company    @relation(fields: [companyId], references: [id])
  form         Form?      @relation(fields: [formId], references: [id])
  responses    Response[]
}

enum UserType {
  RH
  CANDIDATO
}

enum NotificationType {
  FEEDBACK
  GENERAL
}
