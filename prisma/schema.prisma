generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  photoUrl  String?
  userType  UserType
  createdAt DateTime @default(now())
}

enum UserType {
  RH
  CANDIDATO
}