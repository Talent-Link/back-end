generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  RH
  CANDIDATO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  photoUrl  String?
  userType  UserType
  createdAt DateTime @default(now())

  // Relação inversa para Form (RH cria formulários)
  forms Form[] @relation("UserForms")

  // Relação inversa para Response (Candidato responde formulários)
  responses Response[]
}

model Form {
  id          String  @id @default(cuid())
  title       String
  description String?
  questions   Json
  recruiterId String

  // Relação para User, referenciando recruiterId
  recruiter User @relation("UserForms", fields: [recruiterId], references: [id])

  // Relação inversa para Response (Respostas dos candidatos)
  responses Response[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Response {
  id          String   @id @default(cuid())
  candidateId String   // ID do candidato que respondeu
  formId      String   // ID do formulário respondido
  answers     Json     // Respostas do candidato (em formato JSON)
  createdAt   DateTime @default(now())

  // Relação para User (Candidato que respondeu)
  candidate User @relation(fields: [candidateId], references: [id])

  // Relação para Form (Formulário respondido)
  form Form @relation(fields: [formId], references: [id])
}